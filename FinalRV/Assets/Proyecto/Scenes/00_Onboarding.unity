  m_Script: {fileID: 11500000, guid: e500ac2b6b2751047a0efef8c5026068, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InputHintUI
  texto: {fileID: 1675833966}
  pistas:
  - gafas: "Camina con el stick izquierdo o teletransp\xF3rtate. Gira con el stick derecho."
    simulador: Camina con WASD y mira con el mouse hasta la marca verde. Gira la vista.
    holograma: {fileID: 0}
  - gafas: "Agarra la probeta con el GRIP (bot\xF3n lateral del mando)."
    simulador: "Apunta a la probeta y mant\xE9n la tecla G."
    holograma: {fileID: 0}
  - gafas: Acerca la probeta al matraz y suelta el GRIP.
    simulador: Acerca la probeta al matraz y suelta la tecla G.
    holograma: {fileID: 0}
  - gafas: "Presiona el bot\xF3n con el GATILLO (rayo) o t\xF3calo con el dedo."
    simulador: "Apunta al bot\xF3n y haz clic."
    holograma: {fileID: 0}
  - gafas: "Agarra la bola de la palanca con el GRIP y ll\xE9vala a la zona verde 2 s."
    simulador: "Mant\xE9n G sobre la palanca y ll\xE9vala a la zona verde 2 s."
    holograma: {fileID: 0}
  holograma: {fileID: 0}
